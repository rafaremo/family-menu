PORT=3010
DATABASE_URL=postgres://family:family@127.0.0.1:5434/family_menu
POSTGRES_PASSWORD=family

# Better Auth
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo
BETTER_AUTH_URL=http://localhost:3010
# Producción: BETTER_AUTH_URL=https://menu.rafaymon.com

# Admin inicial (scripts/seed.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Archivos
UPLOADS_DIR=./uploads

# MCP: permitir token en la ruta /mcp/t/<token> (para Claude.ai / ChatGPT)
MCP_ALLOW_PATH_TOKEN=true
