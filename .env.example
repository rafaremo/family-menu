# Solo desarrollo (npm run dev). En Coolify NO lo pongas: la imagen usa PORT=3000 (= "Ports Exposes").
PORT=3010
DATABASE_URL=postgres://family:family@127.0.0.1:5434/family_menu
POSTGRES_PASSWORD=family

# Better Auth
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo
BETTER_AUTH_URL=http://localhost:3010
# Producción: BETTER_AUTH_URL=https://menu.rafaymon.com

# Admin inicial (scripts/seed.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Archivos (fotos de recetas).
# Sin R2_BUCKET se guardan en disco (UPLOADS_DIR). Con R2 todo va bajo R2_PREFIX dentro del bucket
# y la app los sirve con sesión (/fotos/...), aunque el bucket tenga dominio público.
UPLOADS_DIR=./uploads
# R2_ACCOUNT_ID=481c4380225c2cbcc9c65b58a75f9744
# R2_BUCKET=rafaymon-bucket
# R2_PREFIX=family-menu
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=   # opcional (p. ej. jurisdicción EU: https://<cuenta>.eu.r2.cloudflarestorage.com)
# Verifica con: npm run storage:check

# URL pública (links y snippets MCP en Mi cuenta). Default: BETTER_AUTH_URL
# PUBLIC_URL=https://menu.rafaymon.com

# MCP: permitir token en la ruta /mcp/t/<token> (para Claude.ai / ChatGPT)
MCP_ALLOW_PATH_TOKEN=true

# Producción (Coolify): ver docs/DEPLOY.md. La imagen ya define NODE_ENV=production, PORT=3000 y
# TRUST_PROXY=true (confía en X-Forwarded-* de Traefik). BETTER_AUTH_SECRET: mínimo 32 caracteres.
# APP_TIMEZONE=America/Mexico_City

# Pruebas (npm test): BD separada, se crea y migra sola
TEST_DATABASE_URL=postgres://family:family@127.0.0.1:5434/family_menu_test
